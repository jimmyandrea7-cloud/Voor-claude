# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=refcheck

# Admins (comma-separated emails), optional
ADMIN_EMAILS=

# Local photo storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Anthropic (AI vision analysis) — leave blank to keep analysis disabled/free of charge
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MAX_ANALYSES_PER_DAY_PER_USER=10

# Google OAuth — leave blank to keep login disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Cookie settings — use these values for local http:// dev; switch back to
# COOKIE_SECURE=true / COOKIE_SAMESITE=none once deployed behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Stripe — leave blank to keep payments disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REPORT_UNLOCK_LOOKUP_KEY=report_unlock_single

CORS_ORIGINS=http://localhost:3000
